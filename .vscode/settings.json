{
    // Conda environment of this project (same name as the folder), used for running, debugging and
    // type checking, and activated automatically in new integrated terminals.
    "python.defaultInterpreterPath": "/media/SSD_1To/conda/envs/Beyond_All_Reason_Reinforcement_Learning/bin/python",
    "python.terminal.activateEnvironment": true,

    // basedpyright provides completion and type checking (Pylance does not run in VSCodium);
    // its settings are in pyproject.toml.
    "python.languageServer": "None",

    // Ruff formats and sorts imports on save; its settings are in pyproject.toml.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },
    "editor.rulers": [120],

    // Lua widgets run inside the game, which provides these globals.
    "Lua.runtime.version": "Lua 5.1",
    "Lua.diagnostics.globals": ["widget", "gadget", "Spring", "Json", "Platform", "VFS", "WG", "GG"],

    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],

    // Do not treat the read-only clones in reference/ as repositories of this project.
    "git.repositoryScanIgnoredFolders": ["reference", "game_data", "runs"],
    "git.autoRepositoryDetection": "openEditors",
    // game_data/ holds thousands of files and several GB: keep it out of the explorer, search and file watcher.
    "files.exclude": {
        "game_data": true,
        "**/__pycache__": true
    },
    "files.watcherExclude": {
        "**/game_data/**": true,
        "**/reference/**": true,
        "**/runs/**": true
    },
    "search.exclude": {
        "game_data": true,
        "reference": true,
        "runs": true
    }
}
